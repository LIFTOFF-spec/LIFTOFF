# =============================================================
# LIFTOFF — contoh konfigurasi environment
# Salin ke .env lalu isi. File .env TIDAK boleh di-commit.
# JANGAN menaruh private key apa pun di file ini.
# =============================================================

# --- Solana -------------------------------------------------------
# Mainnet hanya menyala bila SEMUA terisi: SOLANA_CLUSTER=mainnet-beta, STONKFUN_MAINNET_ENABLED=1,
# LIFTOFF_MAINNET_APPROVED=ya (setelah persetujuan tertulis pemilik), MASTER_WALLET_PUBKEY cocok
# dengan keypair signer. docs/DEPLOY.md §12.
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# F8 (Tahap 10): RPC cadangan (penyedia BERBEDA). Dipakai untuk failover baca semua aplikasi, dan
# oleh signer untuk cek silang saldo + state pool sebelum aksi besar. Kosong = tanpa cadangan.
# Devnet publik kedua yang terbukti jalan: https://solana-devnet.api.onfinality.io/public
# Bisa memuat API key: tidak pernah di-log.
RPC_BACKUP_URL=
# Pubkey saja (bukan private key).
MASTER_WALLET_PUBKEY=
JITO_BLOCK_ENGINE_URL=
JITO_TIP_LAMPORTS=

# --- Database & queue (sesuai docker-compose.yml) -----------------
# Role PEMILIK: hanya untuk migrasi (`pnpm db:migrate`) dan `pnpm --filter @liftoff/db roles`.
DATABASE_URL=postgresql://liftoff:liftoff@localhost:5432/liftoff
# F4 (Tahap 10): role Postgres terpisah per aplikasi (dibuat migrasi 20261031150100_app_roles,
# login + password diaktifkan `pnpm --filter @liftoff/db roles` dari URL di bawah).
#   liftoff_api    : tidak bisa menulis economic_ops / ledger ekonomi / reserve_* / signer_spends
#   liftoff_worker : state operasi + ledger (INSERT saja), tidak menyentuh signer_spends/system_flags
#   liftoff_signer : read-only kecuali signer_spends, audit_events, system_flags
# Kosong = aplikasi memakai DATABASE_URL (perilaku lama, satu role) — JANGAN di production.
# Password ≥ 12 karakter, buat acak; contoh di bawah hanya bentuknya.
API_DATABASE_URL=
WORKER_DATABASE_URL=
SIGNER_DATABASE_URL=
# Contoh: postgresql://liftoff_signer:<password-acak>@localhost:5432/liftoff
REDIS_URL=redis://localhost:6379

# --- API ----------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
# Rahasia penanda cookie sesi (wajib di production; di development dibuat acak per proses).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 1 = percayai X-Forwarded-For HANYA dari peer loopback/jaringan privat (Caddy di Docker); entri
# paling kanan yang bukan alamat privat dipakai. Atau daftar IP/CIDR proxy. 0 = abaikan header.
TRUST_PROXY=0
# Upload gambar lokal (default <repo>/.data/uploads, gitignored).
UPLOAD_DIR=
# Signer service (Tahap 4). Kosong = health check melaporkan not_configured.
SIGNER_URL=
# URL publik API (absolut) untuk URI metadata token on-chain (Metaplex JSON).
PUBLIC_API_URL=http://localhost:4000

# --- Web ----------------------------------------------------------
# Alamat API yang dipakai server Next (SSR + proxy /api/* untuk browser).
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# --- Auth -----------------------------------------------------------
# Identitas utama = wallet lewat Sign-In With Solana (tanpa konfigurasi tambahan).
# Akun X (Twitter) OAuth 2.0 OPSIONAL, untuk badge verified creator & kuota lebih besar.
# Kosong = tautan X mode DEV (hanya di luar production, ditandai jelas di UI).
# Isi dari developer.x.com → Project → App → User authentication settings
# (OAuth 2.0, tipe "Web App / Confidential client", callback = X_CALLBACK_URL).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:4000/api/auth/x/callback
# 0 = matikan tautan X mode DEV walau OAuth X belum diisi.
DEV_X_LINK=1

# --- Signer service (apps/signer) ----------------------------------
# Hanya PATH ke file keypair di luar repo; isi key tidak pernah ditulis di sini.
# Hanya apps/signer yang boleh membaca file ini.
SIGNER_KEYPAIR_PATH=
SIGNER_PORT=4100
# Default 127.0.0.1: signer TIDAK boleh terekspos ke jaringan publik.
SIGNER_HOST=127.0.0.1
# F12 (Tahap 10): token per worker dengan cakupan tujuan, masing-masing ≥ 32 karakter, BERBEDA.
#   SIGNER_LAUNCH_TOKEN   → worker launch: launch, deposit_refund, derive mint
#   SIGNER_ECONOMIC_TOKEN → worker economic/reserve: fee_claim, buyback, burn, reserve_fund/deploy
# Isi kedua-duanya di .env signer DAN worker (worker memakai token cakupannya sendiri).
SIGNER_LAUNCH_TOKEN=
SIGNER_ECONOMIC_TOKEN=
# Kompatibilitas: token lama = cakupan SEMUA tujuan (signer mencatat peringatan saat start).
# Worker memakainya bila token cakupan di atas kosong. Kosongkan setelah migrasi ke token per worker.
SIGNER_AUTH_TOKEN=
# Batas signer (lamport; default di packages/shared/src/launch-engine-config.ts).
SIGNER_MAX_LAMPORTS_PER_TX=30000000
SIGNER_MAX_LAMPORTS_PER_24H=5000000000
SIGNER_MAX_TX_PER_24H=400
# F2 (Tahap 10): signer menghitung quote sendiri dari state pool on-chain dan menolak buyback /
# reserve_deploy yang minOut-nya di bawah quote × (1 − bps). Harus ≥ slippage worker
# (BUYBACK_SLIPPAGE_BPS 300, reserve 100); default 500 / 300 (packages/shared SIGNER_POLICY).
SIGNER_MAX_BUYBACK_SLIPPAGE_BPS=
SIGNER_MAX_RESERVE_SLIPPAGE_BPS=
# F3: batas absolut aset keluar dari akun token master (ATA + kustodi) per 24 jam, per mint,
# format sol=<raw>,<mint>=<raw>,default=<raw>. Default: WSOL 10 SOL, mint lain 1e14 raw.
SIGNER_MAX_ASSET_OUTFLOW_PER_24H=
# F8: aksi dengan keluaran ≥ nilai ini (per mint; sol juga berlaku untuk SOL native) dicek silang
# di RPC_BACKUP_URL. Default sol=100000000 (0,1 SOL). Toleransi beda quote antar RPC (bps, 100).
SIGNER_CROSSCHECK_MIN_RAW=
SIGNER_CROSSCHECK_TOLERANCE_BPS=
# 1 = emergency pause keras (tidak bisa di-resume tanpa mengubah env). Pause biasa:
#   pnpm --filter @liftoff/signer pause "alasan"   /   resume "alasan"
SIGNER_PAUSED=0

# --- Launch engine (apps/worker) ------------------------------------
# rpc = RPC biasa (satu-satunya jalur di devnet; BUKAN private bundle).
# jito = bundle Jito + tip (mainnet saja, belum teruji dengan SOL asli; ditolak di devnet).
LAUNCH_SEND_MODE=rpc
LAUNCH_MAX_SUBMISSIONS=3
LAUNCH_WORKER_CONCURRENCY=2
# HANYA devnet, untuk menguji graduation dengan SOL kecil (Tahap 5): target graduation launch
# baru dalam satuan terkecil quote (mis. 100000000 = 0,1 SOL). Kosongkan setelah uji.
LAUNCH_DEVNET_FUND_RAISING_RAW=

# --- Trading (Tahap 5) ---------------------------------------------
# Rute sesudah graduate: cpmm (pool Raydium CPMM langsung; satu-satunya di devnet) |
# jupiter (BELUM dibuat: mainnet tetap cpmm; ditolak saat start di devnet).
TRADE_GRADUATED_ROUTE=cpmm
# Pubkey wallet LIFTOFF penerima referral (share fee LaunchLab). Hanya dipakai jika
# FEE_CONFIG.referralFeeBps > 0 (saat ini 0: referral dimatikan pemilik). Kosong = master
# wallet; off = tanpa referral. Bukan private key.
TRADE_REFERRAL_WALLET=

# --- Data pasar ---------------------------------------------------
JUPITER_API_URL=https://lite-api.jup.ag
# Harga SOL/USD mainnet (StonkFun + cek silang Jupiter). Kosong = SOL_PRICE_CONFIG. Devnet tidak memakai.
SOL_PRICE_MAX_AGE_SECONDS=
SOL_PRICE_MAX_DEVIATION_BPS=
SOL_PRICE_REFRESH_MS=

# --- Anti-copycat & batas launch (Tahap 3; default di packages/shared/src/launch-config.ts) ---
# Ticker yang sudah diperdagangkan di luar dengan likuiditas >= nilai ini (USD) ditolak.
EXTERNAL_TICKER_MIN_LIQUIDITY_USD=10000
EXTERNAL_TICKER_TIMEOUT_MS=4000
# Jika sumber data pasar tidak bisa dihubungi: reject (aman, default) | allow_with_warning.
EXTERNAL_TICKER_UNAVAILABLE_POLICY=reject
# Jarak Hamming pHash maksimum yang dianggap gambar salinan (0–64).
IMAGE_HASH_MAX_DISTANCE=10
LAUNCH_LIMIT_GLOBAL_PER_DAY=200
# Launch per wallet dalam 24 jam bergulir: tanpa / dengan akun X tertaut.
LAUNCH_LIMIT_PER_WALLET_PER_24H=1
LAUNCH_LIMIT_PER_WALLET_WITH_X_PER_24H=3
# Syarat wallet (hanya dicek lewat RPC, tidak dipotong). 0 = tidak dipakai.
WALLET_MIN_BALANCE_LAMPORTS=50000000
WALLET_MIN_AGE_DAYS=0
# Deposit launch = biaya launch dibayar creator (keputusan pemilik 2026-10-31): default AKTIF.
# POST /api/launch wajib menyertakan depositSignature (transfer creator → master wallet). Disimpan
# jika launch live; dikembalikan otomatis hanya jika launch gagal permanen. 0 = launch gratis.
# Jumlah = biaya launch nyata master wallet. Devnet Token-2022 terukur 8.427.560–8.595.200 lamport
# (tergantung panjang metadata) → 0,009 SOL.
# StonkFun mainnet ±0,012 SOL: UKUR ULANG di Tahap 10 sebelum dipakai.
LAUNCH_DEPOSIT_ENABLED=1
LAUNCH_DEPOSIT_LAMPORTS=9000000

# --- Admin (Spec §7 banding anti-copycat) ---------------------------
# Pubkey wallet admin, dipisah koma. Login SIWS dengan wallet ini membuka /admin untuk meninjau
# banding launch High-risk. Kosong = panel admin mati. Bukan private key.
ADMIN_WALLETS=
# Skor risiko minimum untuk High (default di packages/shared/src/launch-config.ts).
ANTI_COPYCAT_HIGH_RISK_SCORE=

# --- Indexer pasar & graduation (Tahap 6, apps/worker: pnpm --filter @liftoff/worker indexer) ---
# RPC khusus indexer (mis. Helius devnet, OPSIONAL). Kosong = RPC_URL. URL bisa memuat API key:
# indexer tidak pernah me-log-nya.
INDEXER_RPC_URL=
INDEXER_POLL_INTERVAL_MS=15000
# Jumlah holder & distribusi LP (getProgramAccounts) disegarkan lebih jarang.
INDEXER_HOLDERS_REFRESH_MS=300000
# Jeda minimum antar panggilan RPC (rate limit RPC publik devnet).
INDEXER_RPC_MIN_INTERVAL_MS=150
INDEXER_MAX_TX_PER_CYCLE=200

# --- Economic engine (Tahap 7, apps/worker `economic`; default di packages/shared/src/economic-config.ts) ---
# Override HANYA untuk uji lokal. Format per quote mint: sol=5000,<mint>=<raw>.
FEE_CLAIM_INTERVAL_MS=
BUYBACK_INTERVAL_MS=
FEE_CLAIM_MIN_RAW=
BUYBACK_MIN_RAW=
BUYBACK_MAX_RAW_PER_TX=
BUYBACK_SLIPPAGE_BPS=
FEE_RECONCILE_GRACE_MS=
# Batas SOL per transaksi claim/buyback/burn di signer (fee + rent ATA), lamport.
SIGNER_MAX_LAMPORTS_PER_ECONOMIC_TX=
# Fee intake: claim (default devnet) | forwarded (default StonkFun asli; creator fee diteruskan otomatis).
FEE_INTAKE=
# Alamat forwarder StonkFun yang dikenal (dipisah koma; diisi setelah dikonfirmasi di mainnet, Tahap 10).
STONKFUN_FORWARDERS=

# --- StonkFun Developer API (MainnetStonkFunAdapter) ---
# TERKUNCI: hanya aktif bila SOLANA_CLUSTER=mainnet-beta DAN flag ini 1 (persetujuan pemilik).
STONKFUN_MAINNET_ENABLED=0
# Launch baru pair non-SOL di mainnet (1 = dibuka). Devnet tidak memakainya.
PAIRS_NON_SOL_ENABLED=0

# --- Conviction Reserve (Tahap 8, apps/worker `reserve`; default RESERVE_CONFIG = nilai Spec §12) ---
# Override HANYA untuk .env uji lokal: threshold $250 diturunkan agar deployment devnet bisa dibuktikan.
RESERVE_MIN_BALANCE_TO_DEPLOY_USD=
RESERVE_INTERVAL_MS=
# Reserve minimum di ATA master sebelum dipindah ke akun kustodi token (format sama, mis. sol=1).
RESERVE_FUND_MIN_RAW=

# --- Monitoring & alert (Tahap 9, apps/worker: pnpm --filter @liftoff/worker monitor) ---
# Ringkasan status: GET /api/health/status. Proses monitor TIDAK memegang key/token signer.
MONITOR_INTERVAL_MS=60000
# Alert yang masih aktif dikirim ulang setelah selang ini (ms).
ALERT_REPEAT_MS=3600000
# Notifikasi eksternal OPSIONAL (kosong = hanya log "ALERT:"). Secret: isi hanya di .env lokal.
# Telegram: token bot dari @BotFather + chat id (keduanya wajib bila salah satu diisi).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Webhook JSON (POST {text, firing, resolved}); wajib https://.
ALERT_WEBHOOK_URL=
