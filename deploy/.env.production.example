# =============================================================
# LIFTOFF — konfigurasi server produksi/staging (Tahap 10b)
# JANGAN diisi manual di sini. Buat file asli dengan:
#     sh scripts/generate-env.sh        (dari folder deploy/)
# → menghasilkan deploy/.env (gitignored, chmod 600) dengan password & token acak.
# File ini (contoh) di-commit; deploy/.env TIDAK BOLEH di-commit / dikirim ke siapa pun.
# Tidak ada private key di file mana pun: keypair master hanya file terpisah di host.
# =============================================================

# --- Domain & HTTPS ------------------------------------------------
# Domain publik yang A-record DNS-nya menunjuk ke IP VPS (mis. staging.contohdomain.com).
DOMAIN=staging.example.com
# Email untuk pemberitahuan sertifikat Let's Encrypt.
ACME_EMAIL=admin@example.com
# Port publik Caddy (biarkan 80/443 di server).
HTTP_PORT=80
HTTPS_PORT=443
# Mode depan Caddy: direct (browser langsung ke server, mis. sslip.io) atau cloudflare (domain di-proxy
# Cloudflare; wajib di mainnet). Lihat docs/DEPLOY.md §Cloudflare.
EDGE_MODE=direct

# --- Solana (MAINNET TERKUNCI) ---------------------------------------
# Tetap devnet sampai pemilik menyetujui mainnet secara tertulis (docs/DEPLOY.md §12).
SOLANA_CLUSTER=devnet
STONKFUN_MAINNET_ENABLED=0
# Hanya diisi "ya" di server mainnet, setelah persetujuan tertulis pemilik.
LIFTOFF_MAINNET_APPROVED=
# Pubkey master wallet mainnet (hanya dipakai di mainnet; devnet memakai alamat di kode).
MASTER_WALLET_PUBKEY=
# RPC utama. Devnet publik gratis cukup untuk staging; RPC berbayar (Helius/QuickNode/Triton)
# disarankan begitu ada pengguna. URL boleh memuat API key (tidak pernah di-log).
RPC_URL=https://api.devnet.solana.com
# F8: RPC cadangan dari penyedia BERBEDA (failover + cek silang signer). Kosong = tanpa cadangan.
RPC_BACKUP_URL=https://solana-devnet.api.onfinality.io/public
# RPC khusus indexer (opsional; kosong = RPC_URL).
INDEXER_RPC_URL=
# RPC untuk wallet di BROWSER (opsional). TERLIHAT PUBLIK: jangan pakai URL ber-API key rahasia.
NEXT_PUBLIC_RPC_URL=

# --- Keypair master (signer) -----------------------------------------
# Path file keypair di HOST, di luar folder repo (lihat docs/DEPLOY.md §Keypair).
# Di-mount read-only ke container signer saja.
SIGNER_KEYPAIR_HOST_PATH=/etc/liftoff/master-keypair.json

# --- Secret (diisi otomatis oleh generate-env.sh; JANGAN dibagikan) --------
POSTGRES_PASSWORD=__GENERATE__
API_DB_PASSWORD=__GENERATE__
WORKER_DB_PASSWORD=__GENERATE__
SIGNER_DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
SESSION_SECRET=__GENERATE__
SIGNER_LAUNCH_TOKEN=__GENERATE__
SIGNER_ECONOMIC_TOKEN=__GENERATE__

# --- Admin & akun X (opsional) -------------------------------------------
# Pubkey wallet admin (dipisah koma) untuk panel banding /admin. Bukan private key.
ADMIN_WALLETS=
# OAuth X (developer.x.com), callback otomatis https://DOMAIN/api/auth/x/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Alert (opsional) ---------------------------------------------------
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Backup -------------------------------------------------------------
# Folder backup di host (pg_dump + arsip upload). Salin rutin ke luar server.
BACKUP_HOST_DIR=/var/backups/liftoff
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- Pengaturan lanjutan (kosong = default kode; lihat .env.example di root) ---
SIGNER_PAUSED=0
LAUNCH_DEPOSIT_ENABLED=1
LAUNCH_DEPOSIT_LAMPORTS=
WALLET_MIN_BALANCE_LAMPORTS=
LAUNCH_LIMIT_GLOBAL_PER_DAY=
SIGNER_MAX_LAMPORTS_PER_24H=
SIGNER_MAX_TX_PER_24H=
MONITOR_INTERVAL_MS=
