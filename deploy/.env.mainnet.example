# =============================================================
# LIFTOFF — template server MAINNET (Tahap 11a). Nilai sengaja KONSERVATIF untuk masa beta.
# Dipakai di server mainnet BARU (IP baru, di belakang Cloudflare), BUKAN di server staging.
#     sh scripts/generate-env.sh --mainnet     (dari folder deploy/)
# → membuat deploy/.env (gitignored, chmod 600) dari file ini dengan password & token acak.
# Panduan: docs/DEPLOY.md §Cloudflare dan docs/MAINNET_TEST.md.
# Tidak ada private key di file mana pun. Jangan tulis IP server mainnet di repo.
# =============================================================

# --- Domain, HTTPS & Cloudflare -------------------------------------------
# Domain publik (DNS di Cloudflare, awan ORANYE / proxied sejak awal).
DOMAIN=liftoff.example.com
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
# Wajib cloudflare di mainnet (deploy.sh menolak selain ini). Caddy membaca IP asli dari
# CF-Connecting-IP hanya dari IP Cloudflare dan menutup koneksi lain.
EDGE_MODE=cloudflare
# Pindah domain (DEPLOY §12a): domain lama tetap melayani metadata & gambar token yang tertulis
# on-chain, sisanya dialihkan ke DOMAIN. Biarkan off bila belum pernah pindah domain.
LEGACY_MODE=off
LEGACY_DOMAIN=

# --- Solana: KUNCI MAINNET -------------------------------------------------
# Tetap devnet/0/kosong sampai hari H. Mainnet hanya menyala bila SEMUA terpenuhi (kode menolak start
# bila kurang satu): SOLANA_CLUSTER=mainnet-beta, STONKFUN_MAINNET_ENABLED=1,
# LIFTOFF_MAINNET_APPROVED=ya (HANYA setelah persetujuan tertulis pemilik), MASTER_WALLET_PUBKEY
# terisi dan cocok dengan keypair di signer. Urutan: docs/DEPLOY.md §12.
SOLANA_CLUSTER=devnet
STONKFUN_MAINNET_ENABLED=0
# Launch baru pair non-SOL. Biarkan 0 sampai satu launch uji non-SOL dan fee-nya terbukti (keputusan
# pemilik 2026-11-02, docs/MAINNET_TEST.md Langkah 9). Trade token yang sudah ada tidak terpengaruh.
PAIRS_NON_SOL_ENABLED=0
LIFTOFF_MAINNET_APPROVED=
# Pubkey master wallet MAINNET (keypair BARU, bukan master devnet). Pubkey saja, BUKAN private key.
MASTER_WALLET_PUBKEY=

# RPC utama: WAJIB RPC berbayar (Helius / QuickNode / Triton / dll.). URL boleh memuat API key
# (tidak pernah di-log). RPC publik api.mainnet-beta.solana.com TIDAK cukup untuk produksi.
RPC_URL=
# RPC cadangan dari penyedia BERBEDA (failover + cek silang signer). Wajib di mainnet.
RPC_BACKUP_URL=
# RPC indexer (opsional; kosong = RPC_URL). Pakai kuota terpisah bila penyedia mendukung.
INDEXER_RPC_URL=
# RPC untuk wallet di BROWSER. TERLIHAT PUBLIK: pakai URL tanpa API key rahasia (mis. endpoint
# yang dibatasi per-domain oleh penyedia). Wajib di mainnet: RPC publik Solana menolak permintaan
# browser (403), jadi bila kosong pembayaran launch & trade gagal. Ditanam saat build web.
NEXT_PUBLIC_RPC_URL=https://solana-rpc.publicnode.com

# Rute trade sesudah graduation: TETAP cpmm (pool Raydium langsung). Jalur jupiter BELUM dibuat di
# kode: bila dipilih, trade & buyback koin yang sudah graduate tidak jalan (pemeriksaan menolak).
TRADE_GRADUATED_ROUTE=cpmm
# HARI H: ganti ke LAUNCH_SEND_MODE=jito (hanya boleh di mainnet; di devnet aplikasi menolak start).
# Jito membuat mint tidak terlihat sebelum mendarat: MENGURANGI risiko sniping, BUKAN anti-sniper.
LAUNCH_SEND_MODE=rpc
# URL block engine resmi Jito + tip (lamport; kosong = default kode).
JITO_BLOCK_ENGINE_URL=
JITO_TIP_LAMPORTS=

# Forwarder fee StonkFun (dipisah koma). Hanya SOL dari alamat ini yang dihitung sebagai fee, jadi
# isi alamat yang sudah terlihat on-chain (docs/MAINNET_TEST.md langkah 4). Jangan menebak.
STONKFUN_FORWARDERS=

# Buyback & reserve boleh membelanjakan fee? Kosong/0 = fee hanya dicatat. Jangan isi 1 sebelum
# penerusan fee terbukti dan langkah wrap SOL ke WSOL dibuat (docs/MAINNET_TEST.md langkah 5).
FEE_SPENDING_ENABLED=0

# Harga SOL/USD: StonkFun + cek silang Jupiter. Kosong = nilai bawaan kode (umur maks 240 detik, selisih
# maks 150 bps = 1,5%, baca tiap 60 detik). Bila tidak terverifikasi: USD n/a, deployment reserve
# ditahan, alert sol_price_unverified. Jangan longgarkan tanpa alasan tertulis.
JUPITER_API_URL=https://lite-api.jup.ag
SOL_PRICE_MAX_AGE_SECONDS=
SOL_PRICE_MAX_DEVIATION_BPS=
SOL_PRICE_REFRESH_MS=

# --- Keypair master (signer) -----------------------------------------------
SIGNER_KEYPAIR_HOST_PATH=/etc/liftoff/master-keypair.json

# --- Secret (diisi otomatis oleh generate-env.sh; JANGAN dibagikan) ----------
POSTGRES_PASSWORD=__GENERATE__
API_DB_PASSWORD=__GENERATE__
WORKER_DB_PASSWORD=__GENERATE__
SIGNER_DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
SESSION_SECRET=__GENERATE__
SIGNER_LAUNCH_TOKEN=__GENERATE__
SIGNER_ECONOMIC_TOKEN=__GENERATE__

# --- Admin & akun X -----------------------------------------------------------
ADMIN_WALLETS=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Alert: wajib di mainnet, KECUALI dilepas pemilik dengan ALERTS_WAIVED=ya ----
# Bot Telegram (@BotFather) + chat id grup tim. Uji dulu: docs/MAINNET_TEST.md langkah 0.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
# Keputusan pemilik 2026-11-01: tanpa alert. Masalah hanya tercatat di log worker-monitor;
# tidak ada yang memberi tahu, jadi cek https://DOMAIN/api/health secara rutin.
ALERTS_WAIVED=ya

# --- Backup -------------------------------------------------------------------
BACKUP_HOST_DIR=/var/backups/liftoff
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30

# --- Batas konservatif masa beta -----------------------------------------------
# Darurat: SIGNER_PAUSED=1 lalu restart signer → semua tanda tangan berhenti (MAINNET_TEST.md).
SIGNER_PAUSED=0

# Deposit launch dibayar creator: ±0,012 SOL. UKUR ULANG sesudah launch uji pertama (biaya
# jaringan + rent + tip Jito yang benar-benar keluar dari master) lalu sesuaikan.
LAUNCH_DEPOSIT_ENABLED=1
LAUNCH_DEPOSIT_LAMPORTS=12000000
# Saldo minimum wallet creator (anti-spam, hanya dicek): 0,05 SOL.
WALLET_MIN_BALANCE_LAMPORTS=50000000

# Total launch per hari untuk seluruh situs (default kode 200). Naikkan pelan-pelan.
LAUNCH_LIMIT_GLOBAL_PER_DAY=10
LAUNCH_LIMIT_PER_WALLET_PER_24H=1
LAUNCH_LIMIT_PER_WALLET_WITH_X_PER_24H=1

# Signer (pengaman terakhir; default kode lebih longgar):
# maks SOL keluar per transaksi launch 0,03 SOL; per 24 jam 0,5 SOL; maks 60 transaksi per 24 jam.
SIGNER_MAX_LAMPORTS_PER_TX=30000000
SIGNER_MAX_LAMPORTS_PER_24H=500000000
SIGNER_MAX_TX_PER_24H=60
# Ekonomi (buyback/burn/reserve): maks 0,003 SOL biaya per transaksi; slippage maks 3%.
SIGNER_MAX_LAMPORTS_PER_ECONOMIC_TX=3000000
SIGNER_MAX_BUYBACK_SLIPPAGE_BPS=300
SIGNER_MAX_RESERVE_SLIPPAGE_BPS=300
# Batas per aset keluar dari akun token master per 24 jam: WSOL 1 SOL, token lain 1e13 raw
# (10 juta token tampilan = 1% suplai). Format: sol=<raw>,<mint>=<raw>,default=<raw>.
SIGNER_MAX_ASSET_OUTFLOW_PER_24H=sol=1000000000,default=10000000000000
# Cek silang RPC cadangan untuk keluaran ≥ 0,05 SOL.
SIGNER_CROSSCHECK_MIN_RAW=sol=50000000,default=100000000

MONITOR_INTERVAL_MS=
