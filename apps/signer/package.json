    "@liftoff/shared": "workspace:*",
    "@liftoff/solana": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.74-alpha",
    "@types/bn.js": "5.2.0",
    "bn.js": "5.2.2"
  }
}
